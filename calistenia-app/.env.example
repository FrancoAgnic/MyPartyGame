# =============================================================================
# Variables de entorno de ejemplo — copiá este archivo a .env.local
# =============================================================================
#
# La aplicación FUNCIONA SIN Supabase en "modo demo" (persistencia en
# localStorage del navegador). Para habilitar autenticación y persistencia en
# la nube, completá las siguientes variables con los datos de tu proyecto
# Supabase (Project Settings -> API).

# URL pública del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima pública (anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Activa el backend Supabase. Si es "false" o falta, la app usa modo demo.
NEXT_PUBLIC_USE_SUPABASE=false
