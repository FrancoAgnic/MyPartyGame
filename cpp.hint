// Visual Studio IntelliSense hint file. NO afecta la compilación (UBT/MSVC lo ignoran); solo le
// dice al motor de "browsing" de VS cómo expandir las macros de reflexión de Unreal, para que no
// tire los avisos "Browsing operations around this macro may fail. Consider adding it to a hint file."
// ni marque falsos errores alrededor de UCLASS/UPROPERTY/GENERATED_BODY, etc.
#define UCLASS(...)
#define UINTERFACE(...)
#define USTRUCT(...)
#define UENUM(...)
#define UPROPERTY(...)
#define UFUNCTION(...)
#define UPARAM(...)
#define UMETA(...)
#define UDELEGATE(...)
#define GENERATED_BODY(...)
#define GENERATED_UCLASS_BODY(...)
#define GENERATED_USTRUCT_BODY(...)
#define GENERATED_UINTERFACE_BODY(...)
#define GENERATED_IINTERFACE_BODY(...)
#define DECLARE_DYNAMIC_MULTICAST_DELEGATE(...)
#define DECLARE_DYNAMIC_MULTICAST_DELEGATE_OneParam(...)
#define DECLARE_DYNAMIC_MULTICAST_DELEGATE_TwoParams(...)
#define DECLARE_DYNAMIC_MULTICAST_DELEGATE_ThreeParams(...)
#define DECLARE_DYNAMIC_DELEGATE(...)
#define DECLARE_DYNAMIC_DELEGATE_OneParam(...)
#define DECLARE_DYNAMIC_DELEGATE_TwoParams(...)
#define DECLARE_MULTICAST_DELEGATE(...)
#define DECLARE_MULTICAST_DELEGATE_OneParam(...)
#define DECLARE_MULTICAST_DELEGATE_TwoParams(...)
#define DECLARE_DELEGATE(...)
#define DECLARE_DELEGATE_OneParam(...)
#define DECLARE_DELEGATE_RetVal(...)
#define DECLARE_LOG_CATEGORY_EXTERN(...)
#define DEFINE_LOG_CATEGORY(...)
#define SLATE_BEGIN_ARGS(...)
#define SLATE_END_ARGS(...)
#define SLATE_ARGUMENT(...)
#define SLATE_ATTRIBUTE(...)
#define SLATE_EVENT(...)
#define SLATE_NAMED_SLOT(...)
#define LOCTEXT(...)
#define NSLOCTEXT(...)
