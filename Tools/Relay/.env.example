# Copiar a ".env" en la VPS y completar. NUNCA subir el .env al repo.

# Token del Cloudflare Tunnel (Zero Trust → Networks → Tunnels → tu túnel → "Install connector":
# es el texto largo que viene después de "--token").
TUNNEL_TOKEN=

# Límites (opcionales)
MAX_ROOMS=200
MAX_PHONES_PER_ROOM=100
HOST_GRACE_SECONDS=120
